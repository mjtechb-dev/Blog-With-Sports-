rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Articles collection:
    // - Anyone can read articles to view news, tactical reports & dynamic pages
    // - Readers can increment view counts
    // - Admin portal can create, edit, draft, and delete articles
    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    
    // Analytics & Visitor counters
    match /analytics/{metricId} {
      allow read, write: if true;
    }
    
    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
